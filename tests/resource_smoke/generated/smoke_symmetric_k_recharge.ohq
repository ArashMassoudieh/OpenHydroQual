# Generated by GIStoOHQ using native OpenHydroQual grammar
# GIS reaches are Trapezoidal Channel Segment blocks from open_channel.json.
# Catchments discharge to stream reaches; GIS junctions are topology-only.
# Block x/y values preserve GIS geometry after uniform canvas scaling.
# The OHQ display Y direction is flipped by default; actual GIS Y values are unchanged.
# Authoritative projected coordinates remain on the watershed model objects.
# Layout scale=0.0259587406584; source span=72703.2488339 x 154090.68; target canvas=5000 x 5000; margin=500.
# Set OPENHYDROQUAL_RESOURCES, OHQ_RAINFALL_FILE and OHQ_ET_FILE as needed.
# Riparian groundwater routing: regional aquifer to near-stream aquifer internally; one near-stream/channel Darcy exchange per HRU-to-reach path.
loadtemplate; filename=../../../resources/main_components.json
addtemplate; filename=../../../resources/rainfall_runoff.json
addtemplate; filename=../../../resources/open_channel.json
addtemplate; filename=../../../resources/snowmelt.json
addtemplate; filename=../../../resources/riparian_urban_hru.json
addtemplate; filename=../../../resources/soil_evapotranspiration_models.json

# Meteorological source
create source;type=Evapotranspiration_Time_Series (Soil),name=ET,ET_timeseries=../fixtures/ET_1388_1398.txt
create source;type=Evapotranspiration_Time_Series (Soil),name=ET2,ET_timeseries=../fixtures/ET_1388_1398.txt,corr_fact=0.3

# Catchment runoff-generation blocks
create source;type=Air_Temperature,name=AirTemperature_9,timeseries=../fixtures/temp_sub9.txt
create source;type=Liquid_Precipitation,name=LiquidRain_Subbasin_9,timeseries=../fixtures/rain_sub9.txt,Temperature=../fixtures/temp_sub9.txt,temperature_offset=0
create source;type=Snowfall,name=Snowfall_Subbasin_9,timeseries=../fixtures/rain_sub9.txt,Temperature=../fixtures/temp_sub9.txt,temperature_offset=0
create composite;type=Riparian_Urban_HRU_SymmetricKRecharge,name=Subbasin_9,area=889830000[m~^2],impervious_fraction=0.000646536925485,catchment_slope=0.40297,catchment_width=29830.0184378[m],reach_length=74241.62952[m],impervious_reach_length=74241.62952[m],near_stream_fraction=0.05,near_stream_specific_yield=0.15,near_stream_K=1[m/day],hillslope_link_width=61704.587[m],hillslope_link_length=14420.8079701[m],initial_water_table_elevation=2010.959[m],Precipitation=LiquidRain_Subbasin_9,Evapotranspiration=ET,Evapotranspiration_2=ET2,surface_elevation=2016.959[m],x=2336.22039742,y=4500,_width=320,_height=190
create block;type=Snowpack,name=Snowpack_Subbasin_9_Pervious,area=889254692.048[m~^2],Snowfall=Snowfall_Subbasin_9,Temperature=AirTemperature_9,temperature_offset=0,x=2036.22039742,y=4200,_width=240,_height=180
create link;from=Snowpack_Subbasin_9_Pervious,to=Subbasin_9,type=Pervious_Snowmelt_link,name=Snowpack_Subbasin_9_Pervious melt
create block;type=Snowpack,name=Snowpack_Subbasin_9_Impervious,area=575307.952404[m~^2],Snowfall=Snowfall_Subbasin_9,Temperature=AirTemperature_9,temperature_offset=0,x=2636.22039742,y=4200,_width=240,_height=180
create link;from=Snowpack_Subbasin_9_Impervious,to=Subbasin_9,type=Impervious_Snowmelt_link,name=Snowpack_Subbasin_9_Impervious melt

# Trapezoidal stream-reach blocks
create block;type=Trapezoidal Channel Segment,name=Reach_19,base_width=3[m],side_slope=2,ManningCoeff=0.035,bottom_elevation=1405.7364502[m],depth=0.01[m],length=61704.587[m],inflow=,ag_area=0[m~^2],non_ag_area=0[m~^2],ag_withdrawal_per_unit_area=,non_ag_withdrawal_per_unit_area=,dam_height=0[m],x=2571.15633667,y=3812.31219282,_width=320,_height=190
create block;type=Trapezoidal Channel Segment,name=Reach_20,base_width=3[m],side_slope=2,ManningCoeff=0.035,bottom_elevation=1405[m],depth=0.01[m],length=10671.535[m],inflow=,ag_area=0[m~^2],non_ag_area=0[m~^2],ag_withdrawal_per_unit_area=,non_ag_withdrawal_per_unit_area=,dam_height=0[m],x=2875.20428132,y=3232.58242237,_width=320,_height=190
create block;type=fixed_head,name=Outlet,head=0[m],Storage=1000000000[m~^3],x=1556.35760925,y=1110.46822647,_width=260,_height=160

# Watershed runoff discharging into stream reaches
create link;from=Subbasin_9,to=Reach_19,type=Reach_link,name=Subbasin_9 to Junction_13 surface
create link;from=Subbasin_9,to=Reach_19,type=Impervious_Reach_link,name=Subbasin_9 to Junction_13 impervious surface
create link;from=Subbasin_9,to=Reach_19,type=unconfined_groundwater_to_stream,name=Subbasin_9 to Junction_13 baseflow,length=360.520199252[m],area=308522.935[m~^2],hydraulic_conductivity=1[m/day]
# Stream-reach routing links
create link;from=Reach_19,to=Reach_20,type=Trapezoidal_Channel_link,name=Reach_19 to Junction_12
create link;from=Reach_20,to=Outlet,type=channel2fixed,name=Reach_20 to Outlet
# Topology diagnostics
# Projected coordinate reference: EPSG:32638

setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=10
setvalue; object=system, quantity=initial_time_step, value=0.01
setvalue; object=system, quantity=alloutputfile, value=smoke_symmetric_k_recharge_OHQ_output.txt
setvalue; object=system, quantity=observed_outputfile, value=smoke_symmetric_k_recharge_observed.txt