create constituent;type=Constituent,concentration=0[g/m~^3],constant_inflow_concentration=0[g/m~^3],diffusion_coefficient=0[m~^2/s],dispersivity=0[m],external_mass_flow_timeseries=,external_source=,name=PCB,stoichiometric_constant=0,time_variable_inflow_concentration=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1.05,base_value=0.45,name=k_d,reference_temperature=20,temperature=Temperature_pond_example.csv
create reaction;type=Reaction,PCB:stoichiometric_constant=-1,name=Decay,rate_expression=(k_d*PCB)
create block;type=Pond,Evapotranspiration=,PCB:concentration=0[g/m~^3],PCB:constant_inflow_concentration=5[g/m~^3],PCB:external_mass_flow_timeseries=,PCB:external_source=,PCB:time_variable_inflow_concentration=,Precipitation=,Storage=10101.9[m~^3],_height=200,_width=200,alpha=4140,beta=2.2,bottom_elevation=0[m],inflow=Inflow_pond.csv,name=Pond (1),x=943,y=903
create block;type=fixed_head,PCB:concentration=0[g/m~^3],PCB:constant_inflow_concentration=0[g/m~^3],PCB:external_mass_flow_timeseries=,PCB:external_source=,PCB:time_variable_inflow_concentration=,Storage=100000[m~^3],_height=105,_width=122,head=0[m],name=fixed_head (1),x=1337,y=1059
create block;type=fixed_head,PCB:concentration=0[g/m~^3],PCB:constant_inflow_concentration=0[g/m~^3],PCB:external_mass_flow_timeseries=,PCB:external_source=,PCB:time_variable_inflow_concentration=,Storage=100000[m~^3],_height=148,_width=113,head=0[m],name=fixed_head (2),x=1332,y=829
create link;from=Pond (1),to=fixed_head (1),type=Fixed flow,flow=3000[m~^3/day],name=Pond (1) - fixed_head (1)
create link;from=Pond (1),to=fixed_head (2),type=wier,alpha=400000,beta=1.5,crest_elevation=1.35[m],name=Pond (1) - fixed_head (2)
create observation;type=Observation,name=pond_depth,object=Pond (1),expression=depth,error_structure=normal,error_standard_deviation=0.005,observed_data=obs_pond_depth.csv
create observation;type=Observation,name=weir_outflow,object=Pond (1) - fixed_head (2),expression=flow,error_structure=log-normal,error_standard_deviation=0.05,observed_data=obs_weir_outflow.csv
create observation;type=Observation,name=PCB_conc,object=Pond (1),expression=PCB:concentration,error_structure=log-normal,error_standard_deviation=0.05,observed_data=obs_PCB_conc.csv
create parameter;type=Parameter,name=weir_alpha,low=50000,high=5e+06,value=400000,prior_distribution=log-normal
setasparameter; object=Pond (1) - fixed_head (2), quantity=alpha, parametername=weir_alpha
create parameter;type=Parameter,name=crest_elev,low=1,high=2,value=1.35,prior_distribution=normal
setasparameter; object=Pond (1) - fixed_head (2), quantity=crest_elevation, parametername=crest_elev
create parameter;type=Parameter,name=p_k_d,low=0.05,high=20,value=0.45,prior_distribution=log-normal
setasparameter; object=k_d, quantity=base_value, parametername=p_k_d
setvalue; object=LM, quantity=max_iterations, value=40
setvalue; object=LM, quantity=lm_numthreads, value=4
