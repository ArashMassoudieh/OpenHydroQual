create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=2.5,name=K_s,reference_temperature=0,temperature=
create reaction;type=Reaction,A:stoichiometric_constant=-1,B:stoichiometric_constant=0,name=A_Decay,rate_expression=(k_A*A/(K_s+A))
create reaction;type=Reaction,A:stoichiometric_constant=0,B:stoichiometric_constant=-1,name=B_Decay,rate_expression=(k_B*B^2)
create block;type=Reactor,A:concentration=2,A:constant_inflow_concentration=0,A:external_mass_flow_timeseries=,A:external_source=,A:time_variable_inflow_concentration=,B:concentration=2,B:constant_inflow_concentration=0,B:external_mass_flow_timeseries=,B:external_source=,B:time_variable_inflow_concentration=,Storage=9.99998[ft~^3],_height=200,_width=200,bottom_elevation=0,constant_inflow=0,name=Reactor (1),time_variable_inflow=StepFlow.txt [m~^3/day],x=949,y=844
