      "delegate": "UnitBox",
      "unit": "day",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "Time scale over which the forecast decays from the real precipitation (near future) to the corrupted precipitation (far future). The real series is weighted by exp(-(tau-t)/time_scale) and the corrupted series by 1-exp(-(tau-t)/time_scale).",
      "criteria": "time_scale>0",
      "warningmessage": "Forecast trust time scale must be greater than zero"
    },
    "diameter": {
      "type": "value",
      "default": "0.2",
      "description": "Diameter",
      "delegate": "UnitBox",
      "unit": "m;ft;in;cm",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "Valve Diameter",
      "criteria": "diameter>0",
      "warningmessage": "Diameter must be greater than zero"
    },
    "area": {
      "type": "expression",
      "description": "Area",
      "expression": "3.1415*(diameter^2)/4",
      "unit": "m^2;ft^2;inch^2"
    },
    "max_flow": {
      "type": "expression",
      "description": "Maximum flow",
      "includeinoutput": "true",
      "expression": "86400*_sqr(2*9.81*_pos(head.s-head.e)/valve_K)*area",
      "unit": "m^3/day;ft^3/s;m^3/s"
    },
    "valve_K": {
      "type": "expression",
      "description": "Headloss coefficient for valve",
      "includeinoutput": "true",
      "expression": "flow_scale/(kernel_smoothed_forcast+0.0000001)"
    },
    "effective_K": {
      "type": "expression",
      "description": "Headloss coefficient for valve (truncated)",
      "includeinoutput": "true",
      "expression": "_hsd(kernel_smoothed_forcast-threshold)*valve_K"
    },
    "flow_scale": {
      "type": "value",
      "default": "20",
      "description": "Valve Flow factor",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "The scale factor detemining the flow as a function of rain forcast",
      "criteria": "flow_scale>0",
      "warningmessage": "Flow scale must be greater than zero"
    },
    "lambda": {
      "type": "expression",
      "expression": "1/kernel_delay_parameter",
      "description": "lambda (kernel decay rate)",
      "includeinoutput": "false",
      "ask_user": "false"
    },
    "mu": {
      "type": "expression",
      "expression": "1/kernel_delay_parameter+1/time_scale",
      "description": "mu (combined kernel + trust decay rate)",
      "includeinoutput": "false",
      "ask_user": "false"
    },
    "ratio": {
      "type": "expression",
      "expression": "lambda/mu",
      "description": "lambda/mu weighting factor",
      "includeinoutput": "false",
      "ask_user": "false"
    },
    "kernel_smoothed_forcast": {
      "type": "expression",
      "expression": "ratio*_ekr(timeseries;mu)+_ekr(timeseries_corrupted;lambda)-ratio*_ekr(timeseries_corrupted;mu)",
      "description": "Kernel Smoothed Forcast (time-dependent real/corrupted blend)",
      "includeinoutput": "true",
      "ask_user": "false",
      "unit": "m/day;mm/day;mm/hr"
    },
    "flow": {
      "type": "rule",
      "description": "Flow",
      "rule": {
        "kernel_smoothed_forcast<threshold": "0",
        "kernel_smoothed_forcast>threshold": "max_flow"
      },
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;ft^3/s"
    },
    "threshold": {
      "type": "expression",
      "description": "Threshold (tau_k-normalised)",
      "expression": "indicator_mean+z_threshold*indicator_std_ref*((kernel_delay_parameter/tau_ref)^scaling_exponent)",
      "includeinoutput": "true",
      "ask_user": "false",
      "unit": "m/day"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "indicator_mean": {
      "type": "value",
      "default": "0.0048",
      "description": "Indicator mean M",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "false",
      "helptext": "Mean of the kernel-smoothed forecast. Nearly independent of kernel_delay_parameter (measured: 3.8% variation over tau_k = 1..50 d)."
    },
    "indicator_std_ref": {
      "type": "value",
      "default": "0.0038",
      "description": "Indicator std at tau_ref",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "false",
      "helptext": "Standard deviation of the kernel-smoothed forecast at kernel_delay_parameter = tau_ref."
    },
    "tau_ref": {
      "type": "value",
      "default": "10",
      "description": "Reference kernel time scale",
      "delegate": "UnitBox",
      "unit": "day",
      "ask_user": "true",
      "estimate": "false",
      "helptext": "Kernel delay time at which indicator_std_ref was measured."
    },
    "scaling_exponent": {
      "type": "value",
      "default": "-0.404",
      "description": "Indicator std scaling exponent",
      "delegate": "ValueBox",
      "ask_user": "true",
      "estimate": "false",
      "helptext": "std(indicator) ~ kernel_delay_parameter^scaling_exponent. Measured -0.404; pure averaging of white noise would give -0.5."
    },
    "z_threshold": {
      "type": "value",
      "default": "0.35",
      "description": "Threshold in indicator std units",
      "delegate": "ValueBox",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "The valve is shut while the smoothed forecast is below the mean plus z_threshold standard deviations. Dimensionless, so the SAME control decision is expressed at any kernel_delay_parameter -- which a fixed absolute threshold is not: std(indicator) falls 4.8x from tau_k = 1 to 50 d, so a fixed threshold silently drifts from 0.12 to 0.66 standard deviations above the mean."
    }
  },
  "Flow_control_device (function uncertain graded)": {
    "type": "link",
    "typecategory": "Connectors",
