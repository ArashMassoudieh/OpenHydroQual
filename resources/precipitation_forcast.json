      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "transition_width": {
      "type": "value",
      "default": "0.002",
      "description": "Opening transition width",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "Indicator excess above the threshold at which the valve reaches half of its maximum opening. The valve is fully shut at and below the threshold and opens progressively above it. Delta -> 0 recovers the hard on/off rule.",
      "criteria": "transition_width>0",
      "warningmessage": "Transition width must be greater than zero"
    },
    "opening": {
      "type": "expression",
      "description": "Valve opening fraction",
      "expression": "_pos(kernel_smoothed_forcast-threshold)/(_pos(kernel_smoothed_forcast-threshold)+transition_width)",
