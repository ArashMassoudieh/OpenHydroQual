{
  "solutionorder": [ "Storage" ],
  "Precipitation_w_forcast": {
    "type": "source",
    "typecategory": "Sources",
    "description": "Precipitation with forcast",
    "icon": {
      "filename": "cloud.png"
    },
    "coefficient": {
      "type": "expression",
      "expression": "area",
      "ask_user": "false",
      "delegate": "ValueBox"
    },
    "timeseries": {
      "type": "timeseries_prec",
      "includeinoutput": "true",
      "description": "Precipitation intensity",
      "ask_user": "true",
      "delegate": "Browser;time series",
      "unit": "m;in;ft;cm;mm"
   },
   "kernel_smoothed_forcast": {
	"type": "expression",
	"expression": "_ekr(timeseries;0.5)",
	"description": "Kernel Smoothed Forcast",
	"includeinoutput": "true",
        "ask_user": "false",
        "unit": "m/day;in/day;ft/day;cm/day;mm/day"
   }
  },
  "Flow_control_device": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Flow control device",
    "icon": {
      "filename": "control_valve.png"
    },
    "timeseries": {
      "type": "timeseries_prec",
      "includeinoutput": "true",
      "description": "Precipitation intensity",
      "ask_user": "true",
      "delegate": "Browser;time series",
      "unit": "m;in;ft;cm;mm"
   },
   "flow_coefficient": {
      "type": "value",
      "default": "1",
      "description": "Flow multiplier",
      "delegate": "ValueBox",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "This coefficient is multiplied by the Qmin and Qmax for flow control, often to correct for contributing catchment area", 
      "criteria": "flow_coefficient>0",
      "warningmessage": "flow_coefficient must be greater than zero"
    },
   "kernel_delay_parameter": {
      "type": "value",
      "default": "5",
      "description": "Mean kernel delay time",
      "delegate": "UnitBox",
      "unit": "day",
      "ask_user": "true",
      "estimate": "true",
      "helptext": "The mean time of the exponential kernel function for precipitation forcast", 
      "criteria": "kernel_delay_parameter>0",
      "warningmessage": "Mean kernel delay time must be greater than zero"
    },
   "lambda": {
	"type": "expression",
	"expression": "1/kernel_delay_parameter",
	"description": "lambda",
	"includeinoutput": "false",
        "ask_user": "false"
   }, 
   "kernel_smoothed_forcast": {
	"type": "expression",
	"expression": "_ekr(timeseries;lambda)",
	"description": "Kernel Smoothed Forcast",
	"includeinoutput": "true",
        "ask_user": "false",
        "unit": "m/day;in/day;ft/day;cm/day;mm/day"
   },
    "flow": {
      "type": "rule",
      "description": "Flow",
      "rule": {
	      "kernel_smoothed_forcast<S_min": "flow_coefficient*Q_min",
	      "S_min<kernel_smoothed_forcast<S_max": "flow_coefficient*(Q_min+((kernel_smoothed_forcast-S_min)/(S_max-S_min))*(Q_max-Q_min))",
	      "kernel_smoothed_forcast>S_max": "flow_coefficient*Q_max"
    	},
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;ft^3/day;m^3/s"
    },
    "Q_min": {
      "type": "value",
      "default": "10",
      "description": "Minimum flow",
      "delegate": "UnitBox",
      "unit": "m~^3/day;ft~^3/day",
      "ask_user": "true",
      "estimate": "true"
    },
    "Q_max": {
      "type": "value",
      "default": "100",
      "description": "Maximum flow",
      "delegate": "UnitBox",
      "unit": "m~^3/day;ft~^3/day",
      "ask_user": "true",
      "estimate": "true"
    },
    "S_min": {
      "type": "value",
      "default": "0",
      "description": "Lower precipitation threshold",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "true"
    },
    "S_max": {
      "type": "value",
      "default": "100",
      "description": "Upper precipitation threshold",
      "delegate": "UnitBox",
      "unit": "m/day",
      "ask_user": "true",
      "estimate": "true"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    }
  },
