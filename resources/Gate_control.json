{
  "Gate_Opening": {
    "type": "constituent",
    "typecategory": "Constituents",
    "description": "Gate Opening",
    "icon": {
      "filename": "Gate_Opening.png"
    },
    "concentration": {
      "description": "Concentration",
      "type": "expression",
      "expression": "mass",
      "ask_user": "false",
      "role": "copytoblocks",
      "includeinoutput": "false",
      "delegate": "ValueBox",
      "estimate": "false"
    },
    "mass": {
      "description": "Gate Opening",
      "type": "balance",
      "massbalance": "true",
      "inflow": "external_source",
      "includeinoutput": "true",
      "ask_user": "true",
      "role": "copytoblocks"
    },
    "masstransfer": {
      "description": "Mass transfer rate",
      "type": "expression",
      "expression": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "min_safe_opening": {
  "type": "value",
  "default": "0.762",
  "description": "Minimum Safe Gate Opening (e.g. Manatee Protection)",
  "delegate": "UnitBox",
  "unit": "m",
  "ask_user": "true",
  "estimate": "true",
  "includeinoutput": "true"
},

"external_source": {
  "type": "expression",
  "expression": "_hsd(head-max_depth_criteria)*increase_rate*_pos(max_gate_opening-mass)/_pos(max_gate_opening-mass+0.01) - _hsd(low_depth_criteria-head)*decrease_rate*_pos(mass)/_pos(mass+0.01)",
  "includeinoutput": "true",
  "description": "Rate of Change (with Min Safe Opening)",
  "ask_user": "false",
  "role": "copytoblocks"
},

    "is_below_lower": {
      "type": "expression",
      "expression": "_hsd(low_depth_criteria-depth)",
      "includeinoutput": "true",
      "description": "is_below_lower",
      "ask_user": "false",
      "role": "copytoblocks"
    },
    "is_above_higher": {
      "type": "expression",
      "expression": "_hsd(depth-max_depth_criteria)",
      "includeinoutput": "true",
      "description": "is_above_higher",
      "ask_user": "false",
      "role": "copytoblocks"
    },

        "check max opening": {
      "type": "expression",
      "expression": "_pos(max_gate_opening-mass)/_pos(max_gate_opening-mass+0.01)",
      "includeinoutput": "true",
      "description": "check max opening",
      "ask_user": "false",
      "role": "copytoblocks"
    },
    

    "decrease_rate": {
      "type": "value",
      "default": "10",
      "description": "Decrease Rate",
      "delegate": "UnitBox",
      "unit": "1/day;1/min",
      "ask_user": "true",
      "estimate": "true"
    },
    "increase_rate": {
      "type": "value",
      "default": "10",
      "description": "Increase Rate",
      "delegate": "UnitBox",
      "unit": "1/day;1/min",
      "ask_user": "true",
      "estimate": "true"
    },
    "low_depth_criteria": {
      "type": "value",
      "default": "10",
      "description": "Minimum depth at which gate starts closing",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "ask_user": "true",
      "estimate": "true"
    },
    "max_depth_criteria": {
      "type": "value",
      "default": "10",
      "description": "Maximum depth at which gate starts Opening",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "ask_user": "true",
      "estimate": "true"
    },
        "max_gate_opening": {
      "type": "value",
      "default": "10",
      "description": "Maximum Gate can Open",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "ask_user": "true",
      "estimate": "true"
    }
  },

  "controlable_wier":{
		"type": "link",
		"typecategory": "Connectors",
                "description": "Automatically Controlled Weir",
		"icon": {
			"filename": "controlable_weir.png"
		},
                "color": {
      			"type": "string",
      			"default": "0,200,200"
    		},
   		"gate_coeff": {
		      "type": "value",
		      "description": "Gate-flow relationship coefficient",
		      "ask_user": "true",
		      "delegate": "ValueBox",
		      "estimate": "true",
		      "default": "1000",
		      "criteria": "gate_coeff>0",
		      "warningmessage": "Gate coefficient must be positive"
   		},
   		"sill_elevation": {
		      "type": "value",
		      "description": "Sill elevation",
		      "ask_user": "true",
		      "delegate": "UnitBox",
          "unit": "m",
		      "estimate": "true",
		      "default": "1"
   		},
           		"width": {
		      "type": "value",
		      "description": "gate width",
		      "ask_user": "true",
		      "delegate": "UnitBox",
          "unit": "m",
		      "estimate": "true",
		      "default": "1"
   		},
          "flow": {
          "type": "expression",
           "description": "Submerged Weir Flow",
           "expression": "gate_coeff*_pos(gate_opening)*width*(2*9.81*_pos(head.s-head.e))",
             "includeinoutput": "true",
            "applylimit": "true"
},

	        "area" : {
		      	"type": "expression",
			"description": "Area",
                       "expression" : "_pos(Gate_Opening_1:mass.s)*width",
			"includeinoutput" : "true"
		},
    	        "gate_opening" : {
		      	"type": "expression",
			"description": "Gate Opening",
                       "expression" : "_hsd(Gate_Opening_1:mass.s-0.01)*_max(_min(Gate_Opening_1:mass.s;Gate_Opening_1:max_gate_opening);Gate_Opening_1:min_safe_opening)",
			"includeinoutput" : "true"
		},
		"min_gate_opening" : {
		      	"type": "expression",
			"description": "Min Gate Opening",
                        "expression" : "Gate_Opening_1:min_safe_opening",
			"includeinoutput" : "true"
		},
		"hsd" : {
		      	"type": "expression",
			"description": "hsd",
                        "expression" : "_hsd(Gate_Opening_1:mass.s-0.01)",
			"includeinoutput" : "true"
		},
		"length" : {
		      	"type": "value",
			"description": "length",
			"default": "1",
			"includeinoutput" : "false"
		}  	
	},
		"imposed_gate_control_weir": {
  "type": "link",
  "typecategory": "Connectors",
  "description": "S26 Imposed Gate Control Weir - Submerged Orifice",

  "icon": {
    "filename": "controlable_weir.png"
  },

  "color": {
    "type": "string",
    "default": "0,150,250"
  },

  "observed_gate_opening_01": {
    "type": "timeseries",
    "description": "Observed Gate Opening - Gate 1",
    "delegate": "Browser",
    "unit": "m;ft",
    "ask_user": "true",
    "estimate": "true",
    "includeinoutput": "true",
    "is_timeseries": "true"
  },

  "observed_gate_opening_02": {
    "type": "timeseries",
    "description": "Observed Gate Opening - Gate 2",
    "delegate": "Browser",
    "unit": "m;ft",
    "ask_user": "true",
    "estimate": "true",
    "includeinoutput": "true",
    "is_timeseries": "true"
  },

  "discharge_coefficient": {
    "type": "value",
    "description": "Submerged Orifice Discharge Coefficient Cd",
    "delegate": "ValueBox",
    "ask_user": "true",
    "estimate": "true",
    "default": "0.70",
    "criteria": "discharge_coefficient>0",
    "warningmessage": "Discharge coefficient must be positive"
  },

  "width": {
    "type": "value",
    "description": "Width of Each Gate",
    "delegate": "UnitBox",
    "unit": "m;ft",
    "ask_user": "true",
    "estimate": "false",
    "default": "7.9248"
  },

  "area_gate_01": {
    "type": "expression",
    "description": "Flow Area - Gate 1",
    "expression": "_pos(observed_gate_opening_01)*width",
    "includeinoutput": "true",
    "unit": "m^2"
  },

  "area_gate_02": {
    "type": "expression",
    "description": "Flow Area - Gate 2",
    "expression": "_pos(observed_gate_opening_02)*width",
    "includeinoutput": "true",
    "unit": "m^2"
  },

  "flow_gate_01": {
    "type": "expression",
    "description": "Submerged Orifice Forward Flow - Gate 1",
    "expression": "discharge_coefficient*area_gate_01*(2*9.81*_pos(head.s-head.e))^(1/2)",
    "includeinoutput": "true",
    "unit": "m^3/s"
  },

  "flow_gate_02": {
    "type": "expression",
    "description": "Submerged Orifice Forward Flow - Gate 2",
    "expression": "discharge_coefficient*area_gate_02*(2*9.81*_pos(head.s-head.e))^(1/2)",
    "includeinoutput": "true",
    "unit": "m^3/s"
  },

  "leakage_area": {
    "type": "value",
    "description": "Equivalent leakage area when the gates are closed",
    "delegate": "UnitBox",
    "unit": "m~^2;ft~^2",
    "ask_user": "true",
    "estimate": "true",
    "default": "0",
    "criteria": "leakage_area>-0.0000001",
    "warningmessage": "Leakage area cannot be negative",
    "helptext": "Flow area that passes water regardless of the observed gate openings (seal leakage, partially seated gates). Flow = discharge_coefficient * leakage_area * sqrt(2 g dh). Zero reproduces the closed-gate behaviour."
  },

  "flow_leakage": {
    "type": "expression",
    "description": "Leakage flow through the closed structure (m3/s)",
    "expression": "discharge_coefficient*leakage_area*(2*9.81*_pos(head.s-head.e))^(1/2)",
    "includeinoutput": "true",
    "unit": "m^3/s"
  },

  "flow_m3_sec": {
    "type": "expression",
    "description": "Total S26 Submerged Orifice Flow including leakage (m3/s)",
    "expression": "flow_gate_01+flow_gate_02+flow_leakage",
    "includeinoutput": "true",
    "unit": "m^3/s"
  },

  "flow": {
    "type": "expression",
    "description": "Total S26 Submerged Orifice Flow (m3/day)",
    "expression": "flow_m3_sec*86400",
    "includeinoutput": "true",
    "applylimit": "true",
    "unit": "m^3/day"
  },

  "flow_ft3_sec": {
    "type": "expression",
    "description": "Total S26 Submerged Orifice Flow (ft3/s)",
    "expression": "flow_m3_sec*35.3147",
    "includeinoutput": "true",
    "unit": "ft^3/s"
  },

  "flow_ft3_day": {
    "type": "expression",
    "description": "Total S26 Submerged Orifice Flow (ft3/day)",
    "expression": "flow*35.3147",
    "includeinoutput": "true",
    "unit": "ft^3/day"
  },

  "length": {
    "type": "value",
    "description": "length",
    "default": "1",
    "includeinoutput": "false"
  },

  "area": {
    "type": "value",
    "description": "Area",
    "default": "0",
    "includeinoutput": "false",
    "ask_user": "false",
    "unit": "m^2;ft^2",
    "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
  }
},
  "trench_outfall": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Trench outfall (flap-gated drain)",
    "icon": {
      "filename": "trench_outfall.png"
    },
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String"
    },
    "color": {
      "type": "string",
      "default": "0,70,200"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Outlet crest elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft",
      "default": "-1.8",
      "helptext": "Elevation of the drain crest. The outfall flows only when the upstream head exceeds both this crest and the receiving water level."
    },
    "head_loss_coefficient": {
      "type": "value",
      "description": "Head-loss coefficient",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "4007.95",
      "criteria": "head_loss_coefficient>0",
      "warningmessage": "Head-loss coefficient must be positive",
      "helptext": "Lumped entrance, friction and exit losses. The calibrated Arena exfiltration-trench unit gives 4007.95."
    },
    "pipe_diameter": {
      "type": "value",
      "description": "Outlet pipe diameter",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft;cm",
      "default": "0.457",
      "criteria": "pipe_diameter>0",
      "warningmessage": "pipe diameter must be positive"
    },
    "driving_head": {
      "type": "expression",
      "description": "Driving head: upstream head above max(crest, receiving head)",
      "expression": "_pos(head.s-_max(crest_elevation;head.e))",
      "includeinoutput": "true",
      "unit": "m"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "86400*3.47*driving_head^(0.5)/((head_loss_coefficient+1)^0.5)*(pipe_diameter^2)",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/s"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    },
    "helptext": "Drain of an exfiltration-trench unit to a receiving water body, with a flap gate and tailwater. Q = 86400*3.47*sqrt(h_s - max(crest, h_e))_+ / sqrt(K+1) * d^2. No backflow: Q = 0 whenever the receiving head is at or above the upstream head."
  },
  "trench_network_outfall": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Trench-network outfall (fitted network curve, flap-gated)",
    "icon": {
      "filename": "trench_network_outfall.png"
    },
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String"
    },
    "color": {
      "type": "string",
      "default": "0,70,200"
    },
    "network_coefficient": {
      "type": "value",
      "description": "Network outflow coefficient C",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "615964",
      "criteria": "network_coefficient>0",
      "warningmessage": "C must be positive",
      "helptext": "m3/day per m^beta. Scales with the number of units in the network."
    },
    "reference_elevation": {
      "type": "value",
      "description": "Reference crest elevation z",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft",
      "default": "-1.7024",
      "helptext": "Effective crest of the network: the centre of the distribution of the units' crest elevations."
    },
    "spread": {
      "type": "value",
      "description": "Spread of crest elevations w",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft",
      "default": "0.1055",
      "criteria": "spread>0",
      "warningmessage": "spread must be positive",
      "helptext": "Softplus width representing the spread of the units' crest elevations."
    },
    "exponent": {
      "type": "value",
      "description": "Outflow exponent beta",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "0.5468",
      "criteria": "exponent>0",
      "warningmessage": "exponent must be positive"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "network_coefficient*_pos((_max(head.s-reference_elevation;0)+spread*_log(1+_exp(-_abs(head.s-reference_elevation)/spread)))-(_max(head.e-reference_elevation;0)+spread*_log(1+_exp(-_abs(head.e-reference_elevation)/spread))))^exponent",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/s"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    },
    "helptext": "Outflow of a whole trench network as one fitted curve: Q = C*[sp(h_s - z; w) - sp(h_e - z; w)]_+^beta, sp(x; w) = w ln(1 + e^(x/w)). Zero when the receiving head reaches the network level (flap gate). Superseded by trench_class_outfall, which is accurate near the gate onset."
  },
  "trench_class_outfall": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Trench-class outfall (n units, pipe and orifice in series, flap-gated)",
    "icon": {
      "filename": "trench_class_outfall.png"
    },
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String"
    },
    "color": {
      "type": "string",
      "default": "0,70,200"
    },
    "units": {
      "type": "value",
      "description": "Number of trench units n",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1",
      "criteria": "units>-0.0000001",
      "warningmessage": "Number of units cannot be negative",
      "helptext": "Number of identical exfiltration-trench units in this elevation class (may be fractional: an expected count)."
    },
    "pipe_coefficient": {
      "type": "value",
      "description": "Pipe-limit coefficient a_p (per unit)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "21742.86",
      "criteria": "pipe_coefficient>0",
      "warningmessage": "a_p must be positive",
      "helptext": "m3/day per unit per m^b_p. Fitted to the calibrated Arena unit (trench -> S4 pipe)."
    },
    "pipe_invert": {
      "type": "value",
      "description": "Pipe invert elevation z_p",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft",
      "default": "-1.6419",
      "helptext": "Invert of the pipe from the trench to the outlet structure; no outflow below it."
    },
    "pipe_exponent": {
      "type": "value",
      "description": "Pipe-limit exponent b_p",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1.121",
      "criteria": "pipe_exponent>0",
      "warningmessage": "b_p must be positive"
    },
    "orifice_coefficient": {
      "type": "value",
      "description": "Orifice-limit coefficient c_o (per unit)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "994.35",
      "criteria": "orifice_coefficient>0",
      "warningmessage": "c_o must be positive",
      "helptext": "m3/day per unit per m^b_o. Fitted to the calibrated Arena unit (S4 outlet)."
    },
    "orifice_crest": {
      "type": "value",
      "description": "Orifice crest elevation z_o",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m;ft",
      "default": "-1.794"
    },
    "orifice_exponent": {
      "type": "value",
      "description": "Orifice-limit exponent b_o",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "0.504",
      "criteria": "orifice_exponent>0",
      "warningmessage": "b_o must be positive"
    },
    "pipe_limit": {
      "type": "expression",
      "description": "Pipe-limited flow",
      "expression": "units*pipe_coefficient*_pos(head.s-pipe_invert)^pipe_exponent",
      "includeinoutput": "true",
      "unit": "m^3/day"
    },
    "orifice_limit": {
      "type": "expression",
      "description": "Orifice-limited flow (flap-gated, tailwater)",
      "expression": "units*orifice_coefficient*_pos(head.s-_max(orifice_crest;head.e))^orifice_exponent",
      "includeinoutput": "true",
      "unit": "m^3/day"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "_min(pipe_limit;orifice_limit)",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/s"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Distance used only for diffusive/dispersive constituent transport across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    },
    "helptext": "Outfall of n identical exfiltration-trench units to a receiving water body: Q = n*min(a_p (h_s - z_p)_+^b_p, c_o (h_s - max(z_o, h_e))_+^b_o). The pipe limit (onset at the pipe invert) and the orifice limit (onset at max(crest, receiving head)) act in series; a flap gate prevents backflow. Defaults are the calibrated Arena unit in its own elevation frame: shift z_p and z_o by the class elevation offset. Used with an Aggregate_storage_layer block per class and a partially_submerged_trench_Link to the groundwater cell."
  }
}
