      "filename": "culvert_outlet.png"
    },
    "exit_loss_coeff": {
      "type": "value",
      "description": "Exit loss coefficient",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1",
      "criteria": "exit_loss_coeff>0",
      "warningmessage": "The exit loss coefficient must be greater than zero",
      "helptext": "Head loss coefficient at the culvert exit. A value of 1.0 represents full loss of the barrel velocity head into the receiving channel; use a smaller value when the outlet is well transitioned into a channel of similar section."
    },
    "hgl_rule_lower": {
      "type": "value",
      "description": "Lower limit of the (dc+D)/2 rule, as a headwater ratio",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "0.75",
      "criteria": "hgl_rule_lower>0",
      "warningmessage": "The lower limit must be greater than zero",
      "helptext": "Barrel headwater ratio (head above the outlet invert divided by the barrel rise) below which the HDS-5 (dc+D)/2 hydraulic grade line rule is not applied at all. HDS-5 Section 3.2.2 states the approximate method should not be used if the inlet is unsubmerged and gives adequate results only down to a headwater of 0.75D, which is this default."
    },
    "hgl_rule_upper": {
      "type": "value",
      "description": "Upper limit of the (dc+D)/2 rule, as a headwater ratio",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1.8",
      "criteria": "hgl_rule_upper>hgl_rule_lower",
      "warningmessage": "The upper limit must exceed the lower limit",
      "helptext": "Barrel headwater ratio at which the (dc+D)/2 rule is applied in full; between the two limits it is ramped in linearly. HDS-5 treats the rule as fully applicable above about 1.2D, but applying it that abruptly makes the outlet rating curve non-monotonic and admits up to three simultaneous steady states, because the grade line rises faster than the driving head. A band of at least 1.05 in headwater ratio is needed to keep the rating single-valued; 1.8 is that minimum with margin."
    },
