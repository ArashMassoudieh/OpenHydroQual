    "inlet_invert": {
      "type": "value",
      "description": "Inlet invert elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Elevation of the barrel invert at the upstream face, on the same vertical datum as the connected channel segments."
    },
    "outlet_invert": {
      "type": "value",
      "description": "Outlet invert elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Elevation of the barrel invert at the downstream face, on the same vertical datum as the connected channel segments."
    },
    "ManningCoeff": {
      "type": "value",
      "description": "Manning's roughness coefficient",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "0.013",
      "criteria": "ManningCoeff>0",
      "warningmessage": "Manning's roughness coefficient must be greater than zero",
      "helptext": "Barrel roughness. Typical values: 0.012-0.013 concrete, 0.024 corrugated metal."
    },
    "inflow": {
      "type": "timeseries",
      "description": "Direct inflow time series",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "true",
      "delegate": "Browser",
      "unit": "m^3/day;m^3/s;ft^3/s",
      "helptext": "Optional flow added directly to the barrel, for example drainage entering through the barrel walls or a lateral connection. Leave empty when the barrel is fed only by its inlet and outlet links."
