      "helptext": "Name of the component."
    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "200,0,120",
      "ask_user": "false",
      "delegate": "String"
    },
    "target_release": {
      "type": "timeseries",
      "description": "Target release (demand)",
      "ask_user": "true",
      "delegate": "Browser",
      "unit": "m^3/day;m^3/s;ft^3/s;cfs",
      "includeinoutput": "true",
      "helptext": "Target release time series, e.g. monthly water supply demand."
    },
    "dead_pool_elevation": {
      "type": "value",
      "description": "Dead pool (minimum operating) elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "No release below this level."
    },
    "hedging_elevation": {
      "type": "value",
      "description": "Hedging elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Below this level the release is cut back linearly, reaching zero at the dead pool."
    },
    "conservation_top_elevation": {
      "type": "value",
      "description": "Top of the conservation pool",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Above this level (the flood-control pool) extra water is released."
    },
    "max_safe_release": {
      "type": "value",
      "description": "Maximum non-damaging release",
      "ask_user": "true",
      "default": "0",
      "delegate": "UnitBox",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs",
      "estimate": "true",
      "helptext": "The most that can be released downstream without flooding."
    },
    "flood_ramp": {
      "type": "value",
      "description": "Depth to reach the maximum release",
      "ask_user": "true",
      "default": "0.3",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "The extra release rises from 0 at the top of the conservation pool to the maximum over this depth."
    },
    "tailwater_elevation": {
      "type": "value",
      "description": "Tailwater elevation (hydropower only)",
      "ask_user": "true",
      "default": "0",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Tailwater elevation (hydropower only)"
    },
    "turbine_efficiency": {
      "type": "value",
      "description": "Turbine efficiency (hydropower only)",
      "ask_user": "true",
      "default": "0.85",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Turbine efficiency (hydropower only)"
    },
    "hedging_factor": {
      "type": "expression",
      "description": "Hedging factor",
      "expression": "_min(1;_pos(head.s-dead_pool_elevation)/(hedging_elevation-dead_pool_elevation))",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "flood_release": {
      "type": "expression",
      "description": "Flood-control release",
      "expression": "max_safe_release*_min(1;_pos(head.s-conservation_top_elevation)/flood_ramp)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "target_release*hedging_factor+flood_release",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "power": {
      "type": "expression",
      "description": "Hydropower (kW)",
      "expression": "9.81*flow/86400*_pos(head.s-tailwater_elevation)*turbine_efficiency",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    }
  },
