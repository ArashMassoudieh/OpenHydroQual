{
  "Level_Pool_Reservoir": {
    "type": "block",
    "typecategory": "Blocks",
    "description": "Level-pool reservoir",
    "icon": {
      "filename": "Reservoir_template.png"
    },
    "helptext": "Level-pool reservoir: one water level across the pool (storage indication / modified Puls routing). Storage curve S = S_ref (h/h_ref)^b; surface area A = dS/dh. Losses: evaporation and precipitation through sources, seepage through the bed.",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String",
      "helptext": "Name of the component."
    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "0,90,170",
      "ask_user": "false",
      "delegate": "String"
    },
    "Storage": {
      "type": "balance",
      "massbalance": "true",
      "flow": "flow",
      "inflow": "Precipitation,Evaporation,inflow,seepage",
      "description": "Initial Storage;Storage",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^3;ft~^3;acre-ft",
      "estimate": "true",
      "includeinoutput": "true",
      "criteria": "Storage>-0.0000001",
      "warningmessage": "Storage can not be negative!",
      "helptext": "Volume of water in the reservoir at the start of the simulation (acre-ft, ft3 or m3)."
    },
    "inflow": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "description": "Inflow hydrograph",
      "ask_user": "true",
      "delegate": "Browser",
      "unit": "m^3/day;m^3/s;ft^3/s;cfs",
      "helptext": "Inflow time series (the inflow hydrograph)."
    },
    "Precipitation": {
      "type": "source",
      "includeinoutput": "true",
      "description": "Precipitation on the water surface",
      "ask_user": "true",
      "delegate": "ComboBox;Sources",
      "helptext": "Optional precipitation source; it falls on the water surface area A(h)."
    },
    "Evaporation": {
      "type": "source",
      "includeinoutput": "true",
      "description": "Evaporation from the water surface",
      "ask_user": "true",
      "delegate": "ComboBox;Sources",
      "helptext": "Optional evaporation source, e.g. Evapotranspiration Time Series (S) with pan evaporation and the pan coefficient as its correction factor; it acts on the water surface area A(h)."
    },
    "bottom_elevation": {
      "type": "value",
      "description": "Bottom elevation (lowest point of the pool)",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Elevation of the lowest point of the reservoir; depth is measured from here."
    },
    "storage_ref": {
      "type": "value",
      "description": "Reference storage S_ref",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^3;ft~^3;acre-ft",
      "estimate": "true",
      "criteria": "storage_ref>0",
      "warningmessage": "S_ref must be positive!",
      "helptext": "Storage at the reference depth h_ref, read from the elevation-storage curve (e.g. the storage at the spillway crest)."
    },
    "depth_ref": {
      "type": "value",
      "description": "Reference depth h_ref",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "criteria": "depth_ref>0",
      "warningmessage": "h_ref must be positive!",
      "helptext": "Depth above the bottom at which the storage is S_ref."
    },
    "storage_exponent": {
      "type": "value",
      "description": "Storage curve exponent b",
      "ask_user": "true",
      "default": "2",
      "delegate": "ValueBox",
      "estimate": "true",
      "criteria": "storage_exponent>0.999",
      "warningmessage": "b should be 1 or larger!",
      "helptext": "S = S_ref (h/h_ref)^b. b = 1: vertical walls (constant area); b = 2: area grows linearly with depth; b = 3: a cone or a V-shaped valley. Fit it to two points of the elevation-storage curve: b = ln(S2/S1)/ln(h2/h1)."
    },
    "seepage_rate": {
      "type": "value",
      "description": "Seepage rate through the bed",
      "ask_user": "true",
      "default": "0",
      "delegate": "UnitBox",
      "unit": "m/day;mm/day;ft/day;in/day",
      "estimate": "true",
      "helptext": "Loss through the bed and banks per unit water surface area (optional)."
    },
    "depth": {
      "type": "expression",
      "description": "Water depth",
      "expression": "depth_ref*_pos(Storage^2/(storage_ref*(Storage+1)))^(1/storage_exponent)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft",
      "helptext": "h = h_ref (S/S_ref)^(1/b)"
    },
    "head": {
      "type": "expression",
      "description": "Water surface elevation",
      "expression": "bottom_elevation+depth",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "area": {
      "type": "expression",
      "description": "Water surface area",
      "expression": "storage_exponent*storage_ref/depth_ref*(depth/depth_ref)^(storage_exponent-1)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^2;ft~^2;acre",
      "helptext": "A = dS/dh = b S_ref/h_ref (h/h_ref)^(b-1)"
    },
    "seepage": {
      "type": "expression",
      "description": "Seepage loss",
      "expression": "0-seepage_rate*area",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    }
  },
  "Overflow_Spillway": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Overflow (ogee) spillway, uncontrolled",
    "icon": {
      "filename": "Emergency_Spillway.png"
    },
    "helptext": "Uncontrolled overflow spillway: Q = Cd (2/3) sqrt(2g) L (H - H_crest)^1.5, free flow.",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String",
      "helptext": "Name of the component."
    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "0,120,200",
      "ask_user": "false",
      "delegate": "String"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Crest elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Crest elevation"
    },
    "crest_length": {
      "type": "value",
      "description": "Effective crest length L",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Effective crest length L"
    },
    "discharge_coefficient": {
      "type": "value",
      "description": "Discharge coefficient Cd",
      "ask_user": "true",
      "default": "0.73",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Dimensionless discharge coefficient Cd in Q = Cd (2/3) sqrt(2g) L H^1.5, so it holds in any units. The weir coefficient C of Q = C L H^1.5 is C = 5.35 Cd in ft^0.5/s, or 2.95 Cd in m^0.5/s. Ogee at its design head: Cd about 0.73 (C = 3.9 ft^0.5/s)."
    },
    "head_over_crest": {
      "type": "expression",
      "description": "Head over the crest H",
      "expression": "_pos(head.s-crest_elevation)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*discharge_coefficient*(2/3)*_sqr(2*9.81)*crest_length*_pos(head.s-crest_elevation)^1.5",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    }
  },
