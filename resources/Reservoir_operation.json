  "Gated_Spillway": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Gated spillway (vertical lift gates)",
    "icon": {
      "filename": "Reservoir_Control.png"
    },
    "helptext": "Gated crest (USBR, Design of Small Dams): Q = Cd (2/3) sqrt(2g) b (H1^1.5 - H2^1.5), H1 the head over the crest and H2 the head over the gate lip. Below the gate lip H2 = 0 and it is a free weir; a = 0 closes the gates.",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String",
      "helptext": "Name of the component."
    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "0,150,150",
      "ask_user": "false",
      "delegate": "String"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Crest elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Crest elevation"
    },
    "crest_length": {
      "type": "value",
      "description": "Total gate width b",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Total gate width b"
    },
    "gate_opening": {
      "type": "value",
      "description": "Gate opening a",
      "ask_user": "true",
      "default": "0",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Height of the gate bottom above the crest. 0 closes the gates."
    },
    "discharge_coefficient": {
      "type": "value",
      "description": "Discharge coefficient Cd",
      "ask_user": "true",
      "default": "0.7",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Dimensionless discharge coefficient Cd in Q = Cd (2/3) sqrt(2g) L H^1.5, so it holds in any units. The weir coefficient C of Q = C L H^1.5 is C = 5.35 Cd in ft^0.5/s, or 2.95 Cd in m^0.5/s. Partly open gates: Cd about 0.65 to 0.73."
    },
    "head_over_crest": {
      "type": "expression",
      "description": "Head over the crest H1",
      "expression": "_pos(head.s-crest_elevation)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "head_over_gate_lip": {
      "type": "expression",
      "description": "Head over the gate lip H2",
      "expression": "_pos(head.s-crest_elevation-gate_opening)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*discharge_coefficient*(2/3)*_sqr(2*9.81)*crest_length*(head_over_crest^1.5-head_over_gate_lip^1.5)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    }
  },
  "Outlet_Works": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Outlet works (conduit with valve)",
    "icon": {
      "filename": "Riser_Spillway.png"
    },
    "helptext": "Orifice / conduit outlet: Q = Cd (valve A) sqrt(2g dH). The downstream block must have a head (tailwater).",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String",
      "helptext": "Name of the component."
    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "90,60,160",
      "ask_user": "false",
      "delegate": "String"
    },
    "outlet_elevation": {
      "type": "value",
      "description": "Outlet centerline elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Outlet centerline elevation"
    },
    "outlet_area": {
      "type": "value",
      "description": "Conduit area",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^2;ft~^2",
      "estimate": "true",
      "helptext": "Conduit area"
    },
    "valve_opening": {
      "type": "value",
      "description": "Valve opening (0 to 1)",
      "ask_user": "true",
      "default": "1",
      "delegate": "ValueBox",
      "estimate": "true",
      "criteria": "valve_opening>-0.000001",
      "warningmessage": "The valve opening can not be negative!",
      "helptext": "Fraction of the conduit area that is open."
    },
    "discharge_coefficient": {
      "type": "value",
      "description": "Discharge coefficient Cd",
      "ask_user": "true",
      "default": "0.8",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Cd in Q = Cd A sqrt(2g dH); it lumps the entrance, friction and valve losses."
    },
    "turbine_efficiency": {
      "type": "value",
      "description": "Turbine efficiency (hydropower only)",
      "ask_user": "true",
      "default": "0.85",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Turbine efficiency (hydropower only)"
    },
    "driving_head": {
      "type": "expression",
      "description": "Driving head dH",
      "expression": "_pos(head.s-_max(outlet_elevation;head.e))",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft",
      "helptext": "To the outlet centerline (free outfall) or to the tailwater when it is higher (submerged)."
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*discharge_coefficient*valve_opening*outlet_area*_sqr(2*9.81*driving_head)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "power": {
      "type": "expression",
      "description": "Hydropower (kW)",
      "expression": "9.81*flow/86400*driving_head*turbine_efficiency",
      "ask_user": "false",
      "includeinoutput": "true",
      "helptext": "P = rho g Q H eta, in kW."
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    }
  },
