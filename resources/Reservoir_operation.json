    },
    "color": {
      "description": "Color",
      "type": "string",
      "default": "0,100,100",
      "ask_user": "false",
      "delegate": "String"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Crest elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Crest elevation"
    },
    "crest_radius": {
      "type": "value",
      "description": "Crest radius R",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Crest radius R"
    },
    "discharge_coefficient": {
      "type": "value",
      "description": "Weir discharge coefficient Cd",
      "ask_user": "true",
      "default": "0.6",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Dimensionless discharge coefficient Cd in Q = Cd (2/3) sqrt(2g) L H^1.5, so it holds in any units. The weir coefficient C of Q = C L H^1.5 is C = 5.35 Cd in ft^0.5/s, or 2.95 Cd in m^0.5/s. Circular crest: crest length 2 pi R."
    },
    "outlet_elevation": {
      "type": "value",
      "description": "Conduit outlet elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "helptext": "Conduit outlet elevation"
    },
    "throat_area": {
      "type": "value",
      "description": "Throat / conduit area",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^2;ft~^2",
      "estimate": "true",
      "helptext": "Throat / conduit area"
    },
    "orifice_coefficient": {
      "type": "value",
      "description": "Conduit discharge coefficient",
      "ask_user": "true",
      "default": "0.8",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Cd in Q = Cd A sqrt(2g (H - H_outlet)); lumps the conduit losses."
    },
    "weir_flow": {
      "type": "expression",
      "description": "Crest (weir) control",
      "expression": "86400*discharge_coefficient*(2/3)*_sqr(2*9.81)*2*3.14159265*crest_radius*_pos(head.s-crest_elevation)^1.5",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "conduit_flow": {
      "type": "expression",
      "description": "Conduit (orifice) control",
      "expression": "86400*orifice_coefficient*throat_area*_sqr(2*9.81*(head.s-outlet_elevation))",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "_min(weir_flow;conduit_flow)",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m~^3/day;m~^3/s;ft~^3/s;cfs"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "default": "1",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "helptext": "Used only for diffusive transport of constituents across this link; does not affect flow."
    }
  },
