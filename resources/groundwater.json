    },
    "Storage": {
      "type": "balance",
      "massbalance": "true",
      "flow": "flow",
      "inflow": "inflow",
      "includeinoutput": "true",
      "description": "Storage",
      "initial_value_expression": "porosity*_pos(initial_head-bottom_elevation)*area",
      "ask_user": "false",
      "estimate": "true",
      "unit": "m^3;ft^3"
    },
    "volume": {
      "type": "expression",
      "expression": "depth*area",
      "description": "volume",
      "ask_user": "false",
      "includeinoutput": "false",
      "unit": "m^3;ft^3"
    },
    "inflow": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "description": "Inflow time series",
      "ask_user": "true",
      "delegate": "Browser",
      "helptext": "Time series representing external water input to the groundwater cell, such as recharge from precipitation or surface water.",
      "unit": "m^3/day;ft^3/day;m^3/s"
    },
    "hydraulic_conductivity": {
      "type": "value",
      "description": "Hydraulic Conductivity",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m/day;ft/day;cm/s;in/s;m/s",
      "estimate": "true",
      "default": "1",
      "criteria": "hydraulic_conductivity>0",
      "warningmessage": "Hydraulic conductivity must be greater than zero",
      "helptext": "Rate at which water can move through pore spaces or fractures in the subsurface. Influences groundwater flow velocity."
    },
    "K_eff": {
      "type": "expression",
      "expression": "hydraulic_conductivity",
      "description": "Hydraulic conductivity",
      "ask_user": "false",
      "includeinoutput": "false"
    },
    "porosity": {
      "type": "value",
      "description": "Porosity",
      "ask_user": "true",
      "default": "0.4",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "The fraction of the total volume of the subsurface that is occupied by voids or pores, representing storage capacity."
    },
    "bottom_elevation": {
      "type": "value",
      "description": "Bottom Elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "estimate": "true",
      "helptext": "Elevation of the bottom of the groundwater cell, used to determine hydraulic gradients and head."
    },
    "depth": {
      "type": "value",
      "description": "Cell Depth",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "includeinoutput": "false",
      "criteria": "depth>0",
      "warningmessage": "Cell depth must be greater than zero"
    },
    "moisture_content": {
      "type": "expression",
      "expression": "Storage/(depth*area)",
      "description": "Moisture content",
      "delegate": "ValueBox",
      "estimate": "true",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "head": {
      "type": "expression",
      "expression": "bottom_elevation+Storage/(porosity*area)",
      "description": "Hydraulc Head",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "area": {
      "type": "value",
      "description": "Cell area",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^2;ft~^2;cm~^2;in~^2",
      "includeinoutput": "false",
      "criteria": "area>0",
      "warningmessage": "Cell area must be greater than zero"
    },
    "helptext": "Groundwater cell with a free water table. Storage S = porosity*(head-bottom_elevation)*area, so head = bottom_elevation + Storage/(porosity*area): the water table rises by 1/porosity per unit depth of stored water (porosity acts as the specific yield). The initial state is given as a water-table elevation (initial_head), so it does not change when the porosity changes. Links that use 'head' (groundwater_to_stream, groundwater_link, soil2groundwater links) work unchanged.",
    "initial_head": {
      "type": "value",
      "description": "Initial water-table elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true",
      "includeinoutput": "false",
      "helptext": "Initial head (water-table elevation, same datum as bottom_elevation). Should lie between bottom_elevation and bottom_elevation+depth."
    },
    "water_table_depth": {
      "type": "expression",
      "expression": "Storage/(porosity*area)",
      "description": "Saturated thickness above the cell bottom",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    }
  }
}
