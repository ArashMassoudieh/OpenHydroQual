      "expression": "area*(5.026*velocity*_max(depth;0.01)^(-0.67)+0.728*_sqt(wind_speed)-0.317*wind_speed+0.0372*wind_speed^2)*theta^(temperature-20)*_min(_pos(depth)/0.02;1)*(saturation-concentration)",
      "includeinoutput": "false",
