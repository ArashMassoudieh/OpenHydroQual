    },
    "theta": {
      "type": "value",
      "description": "Temperature coefficient of reaeration",
      "ask_user": "true",
      "delegate": "ValueBox",
      "default": "1.024",
      "helptext": "Reaeration rate correction theta^(T-20); 1.024 is the standard value (Elmore and West 1961)."
    },
    "saturation": {
      "type": "expression",
      "expression": "14.652-0.41022*temperature+0.007991*temperature^2-0.000077774*temperature^3",
      "description": "Saturation concentration",
      "ask_user": "false",
      "includeinoutput": "false",
      "unit": "g/m^3",
      "helptext": "Dissolved-oxygen saturation in fresh water at sea level as a function of temperature (polynomial fit to APHA/Elmore-Hayes data)."
    },
    "timeseries": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "1",
      "ask_user": "false"
    },
    "wind_speed": {
      "type": "timeseries",
      "description": "Wind speed at 10 m",
      "ask_user": "true",
      "delegate": "Browser",
      "default": "0",
      "includeinoutput": "false",
      "unit": "m/s",
      "helptext": "Optional wind-speed series at 10 m. Adds the wind-driven transfer velocity of Banks and Herrera (1977), 0.728 U_w^0.5 - 0.317 U_w + 0.0372 U_w^2 m/day, to the hydraulic one (as in QUAL2K), which keeps still or ponded water reaerating. None given: 0, hydraulic reaeration only."
    },
    "coefficient": {
