{
  "Bed_sediment_layer": {
    "type": "block",
    "typecategory": "Blocks",
    "description": "Bed sediment layer",
    "icon": {
      "filename": "bed_sediment_layer.png"
    },
    "helptext": "A porous sediment layer under a river segment (or pond): water content, porosity, specific storage and hydraulic conductivity. It exchanges water and dissolved constituents with the river through a River to bed sediment link, and with deeper layers or a fixed head below.",
    "Storage": {
      "type": "balance",
      "massbalance": "true",
      "flow": "flow",
      "includeinoutput": "true",
      "description": "Initial Storage; Storage",
      "initial_value_expression": "length*width*depth*porosity",
      "ask_user": "false",
      "estimate": "true"
    },
    "hydraulic_conductivity": {
      "type": "value",
      "description": "Hydraulic Conductivity",
      "helptext": "Hydraulic conductivity of the sediments. \n This value will be used to calculate the water flux into the sediment layer as a result of changes in hydraulic head with the \n overlying water or deeper sediment layers",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m/day;ft/day;cm/s;in/s;m/s",
      "estimate": "true",
      "default": "1",
      "criteria": "hydraulic_conductivity>0",
      "warningmessage": "Hydraulic conductivity must be greater than zero"
    },
    "K_eff": {
      "type": "expression",
      "expression": "hydraulic_conductivity",
      "description": "Hydraulic conductivity",
      "ask_user": "false",
      "includeinoutput": "false"
    },
    "porosity": {
      "type": "value",
      "description": "Porosity",
      "helptext": "Porosity of the sediments",
      "ask_user": "true",
      "default": "0.4",
      "delegate": "ValueBox",
      "estimate": "true"
    },
    "specific_storage": {
      "type": "value",
      "description": "Specific Storage",
      "helptext": "Specific storage of the sediment layer. \n This value will be used to calculate the hydraulic head in the sediment layer in case the water content is different than the porosity.\n The pressure head is calculated as p=(water_content-porosity)/specific_storage",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "1/m;1/ft;1/cm;1/in",
      "estimate": "true",
      "default": "0.01",
      "criteria": "specific_storage>0",
      "warningmessage": "Specific Storage must be greater than zero"
    },
    "bottom_elevation": {
      "type": "value",
      "description": "Bottom Elevation",
      "helptext": "Bottom elelvation of the sediment layer with respect to the model datum",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "estimate": "true"
    },
    "depth": {
      "type": "value",
      "description": "Cell Depth",
      "helptext": "Depth of the sediment layer",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "includeinoutput": "false",
      "criteria": "depth>0",
      "warningmessage": "Cell depth must be greater than zero"
    },
    "water_content": {
      "type": "expression",
      "expression": "Storage/(depth*area)",
      "description": "Initial Water content; Water content",
      "helptext": "Initial water content. In most cases the water content should be equal to the porosity of the sediment layer",
      "ask_user": "true",
      "default": "0.4",
      "delegate": "ValueBox",
      "includeinoutput": "true"
    },
    "head": {
      "type": "expression",
      "expression": "depth+bottom_elevation+(water_content-porosity)/specific_storage",
      "description": "Hydraulic Head",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "length": {
      "type": "value",
      "description": "Element length",
      "helptext": "Length of the sediment block. In most cases the length of the sediment block should be equal to the length of the block representing the overlying water",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "includeinoutput": "false",
      "criteria": "length>0",
      "warningmessage": "Element length must be greater than zero"
    },
    "width": {
      "type": "value",
      "description": "Element width",
      "helptext": "Width of the sediment block. In most cases the length of the sediment block should be equal to the width of the block representing the overlying water",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm;in",
      "includeinoutput": "false",
      "criteria": "width>0",
      "warningmessage": "Element width must be greater than zero"
    },
    "area": {
      "type": "expression",
      "expression": "width*length",
      "description": "Cell area",
      "ask_user": "false"
    }
  },
  "River_segment": {
    "type": "block",
    "typecategory": "Blocks",
    "description": "River segment (trapezoidal section, Manning)",
    "icon": {
      "filename": "river_segment.png"
    },
    "helptext": "A reach of river with a trapezoidal cross-section: base width, side slope, Manning n, bed elevation and length. Water storage sets the depth; flows to neighbouring segments follow Manning's equation through River segment links. Chain segments (Edit > Create 2D Array) to build a river.",
    "Storage": {
      "type": "balance",
      "massbalance": "true",
      "flow": "flow",
      "inflow": "inflow,ag_withdrawal,non_ag_withdrawal",
      "includeinoutput": "true",
      "description": "Storage",
      "initial_value_expression": "length*(base_width+side_slope*depth)*depth",
      "ask_user": "false",
      "estimate": "true"
    },
    "base_width": {
      "type": "value",
      "description": "Base Width",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm",
      "estimate": "true",
      "helptext": "Bottom width of the trapezoidal river cross-section. This defines the flat portion of the riverbed."
    },
    "side_slope": {
      "type": "value",
      "description": "Side Slope",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "criteria": "side_slope>0",
      "warningmessage": "Side slope must be greater than zero",
      "helptext": "Horizontal to vertical ratio of the sloped sides of the river channel (e.g., 2 means 2:1 slope)."
    },
    "ManningCoeff": {
      "type": "value",
      "description": "Manning's Roughness Coefficient",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "helptext": "Manning’s roughness coefficient that defines flow resistance based on channel surface properties."
    },
    "bottom_elevation": {
      "type": "value",
      "description": "Bottom Elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm",
      "estimate": "true",
      "helptext": "Elevation of the riverbed relative to the model's vertical datum."
    },
    "depth": {
      "type": "expression",
      "expression": "(-base_width+_sqr(base_width^2+4*side_slope*_pos(Storage)/length))/(2*side_slope)",
      "precalcbasedon": "Storage:log:0.000001:1000000",
      "description": "Initial Water Depth; Water Depth",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm",
      "includeinoutput": "true",
      "criteria": "depth>-0.0000001",
      "warningmessage": "Depth must be non-negative",
      "helptext": "Initial depth of water in the river segment. Used to estimate flow area and storage."
    },
    "head": {
      "type": "expression",
      "expression": "depth+bottom_elevation",
      "description": "Hydraulic Head",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "velocity": {
      "type": "expression",
      "expression": "velocity.v*1",
      "description": "Velocity",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m/s;m/day;ft/s"
    },
    "length": {
      "type": "value",
      "description": "Segment length",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft;cm",
      "estimate": "true",
      "criteria": "length>0",
      "warningmessage": "Length must be greater than zero"
    },
    "xsectionarea": {
      "type": "expression",
      "expression": "(base_width+side_slope*depth)*depth",
      "description": "Cross-sectional area",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "area": {
      "type": "expression",
      "expression": "length*(base_width+2*side_slope*_pos(depth))",
      "description": "Water-surface (top) area",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m^2;ft^2"
    },
    "perimeter": {
      "type": "expression",
      "expression": "base_width+2*_sqt(1+side_slope^2)*depth",
      "description": "Wetted Perimeter",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "inflow": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "description": "Inflow time series",
      "ask_user": "true",
      "delegate": "Browser"
    },
    "ag_area": {
      "type": "value",
      "description": "Area of agricultural land",
      "ask_user": "true",
      "helptext": "The area of agricultural land served",
      "delegate": "UnitBox",
      "unit": "m~^2",
      "estimate": "true"
    },
    "non_ag_area": {
      "type": "value",
      "description": "Area of non-agricultural activity",
      "ask_user": "true",
      "delegate": "UnitBox",
      "helptext": "The area of non-agricultural land served",
      "unit": "m~^2",
      "estimate": "true"
    },
    "ag_withdrawal": {
      "type": "expression",
      "expression": "-ag_area*ag_withdrawal_per_unit_area*depth/(depth+0.05)",
      "description": "Agricultural Withdrawal",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "non_ag_withdrawal": {
      "type": "expression",
      "expression": "-non_ag_area*non_ag_withdrawal_per_unit_area*depth/(depth+0.05)",
      "description": "Non-Agricultural Withdrawal",
      "ask_user": "false",
      "includeinoutput": "true"
    },
    "ag_withdrawal_per_unit_area": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "helptext": "Time-series representing the time variation of agricultural withrawal per unit area served",
      "description": "Agricultural Withdrawal per unit area",
      "ask_user": "true",
      "delegate": "Browser"
    },
    "non_ag_withdrawal_per_unit_area": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "helptext": "Time-series representing the time variation of non-agricultural withrawal per unit area served",
      "description": "Non-Agricultural Withdrawal per unit area",
      "ask_user": "true",
      "delegate": "Browser"
    }
  },
  "River_link": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "River segment to river segment (Manning)",
    "icon": {
      "filename": "river_link.png"
    },
    "helptext": "Flow between two river segments from Manning's equation: V = (1/n) R^(2/3) S^(1/2), Q = V A, where S is the water-surface slope (head difference over the mean segment length), A the upstream-weighted flow area and R the hydraulic radius with the mean wetted perimeter. The square root of S is smoothed only for |S| below about 1e-8, so flat lowland rivers keep their full Manning flow.",
    "area": {
      "type": "expression",
      "description": "Cross-sectional area",
      "expression": "_max(_bkw(head;xsectionarea);0)",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "perimeter": {
      "type": "expression",
      "description": "Wetted Perimeter",
      "expression": "(perimeter.s+perimeter.e)/2",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "hydraulic_radious": {
      "type": "expression",
      "description": "Hydraulic Radius",
      "expression": "area/perimeter",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "ManningCoeff": {
      "type": "expression",
      "description": "Manning's roughness coefficient",
      "expression": "(ManningCoeff.s+ManningCoeff.e)/2",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "length": {
      "type": "expression",
      "description": "Connector length",
      "expression": "(length.s+length.e)/2",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "velocity": {
      "type": "expression",
      "description": "Velocity",
      "expression": "((head.s-head.e)/length)/(_abs(((head.s-head.e)/length))+0.00000001)^0.5/ManningCoeff*hydraulic_radious^0.666667",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m/s;m/day;ft/s"
    },
    "sediment_exchange": {
      "type": "expression",
      "expression": "0",
      "description": "Settling and resuspension of suspended sediment across this link (1 = yes, 0 = no)",
      "ask_user": "false",
      "includeinoutput": "false"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*velocity*area",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    }
  },
  "Fixedhead_to_river": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Fixed-head boundary to river segment (Manning)",
    "icon": {
      "filename": "fixedhead_to_river.png"
    },
    "helptext": "Inflow to a river segment from a fixed-head (or time-variable fixed-head) boundary, by Manning's equation with the depth set by the boundary level above the segment bed. Use it to let the upstream water level, rather than a prescribed discharge, drive the river.",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String"
    },
    "area": {
      "type": "expression",
      "description": "Cross-sectional area",
      "expression": "(base_width.e+side_slope.e*_pos(head.s-bottom_elevation.e))*_pos(head.s-bottom_elevation.e)",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "perimeter": {
      "type": "expression",
      "description": "Wetted Perimeter",
      "expression": "base_width.e+2*_sqr(1+side_slope.e^2)*_pos(head.s-bottom_elevation.e)",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "hydraulic_radious": {
      "type": "expression",
      "description": "Hydraulic Radius",
      "expression": "area/perimeter",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "ManningCoeff": {
      "type": "expression",
      "description": "Manning's roughness coefficient",
      "expression": "ManningCoeff.e",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "length": {
      "type": "expression",
      "description": "Connector length",
      "expression": "length.e",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "velocity": {
      "type": "expression",
      "description": "Velocity",
      "expression": "((head.s-head.e)/length)/(_abs(((head.s-head.e)/length))+0.00000001)^0.5/ManningCoeff*hydraulic_radious^0.666667",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m/s;m/day;ft/s"
    },
    "sediment_exchange": {
      "type": "expression",
      "expression": "0",
      "description": "Settling and resuspension of suspended sediment across this link (1 = yes, 0 = no)",
      "ask_user": "false",
      "includeinoutput": "false"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*velocity*area",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    }
  },
  "River_to_fixedhead": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "River segment to fixed-head boundary (Manning)",
    "icon": {
      "filename": "river_to_fixedhead.png"
    },
    "helptext": "Outflow from a river segment to a fixed-head boundary by Manning's equation. Setting the boundary level to the normal depth above the bed one segment downstream continues uniform flow out of the reach.",
    "name": {
      "description": "Name",
      "type": "string",
      "ask_user": "true",
      "delegate": "String"
    },
    "area": {
      "type": "expression",
      "description": "Cross-sectional area",
      "expression": "_max(xsectionarea.s;0)",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "perimeter": {
      "type": "expression",
      "description": "Wetted Perimeter",
      "expression": "perimeter.s",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "hydraulic_radious": {
      "type": "expression",
      "description": "Hydraulic Radius",
      "expression": "area/perimeter",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "ManningCoeff": {
      "type": "expression",
      "description": "Manning's roughness coefficient",
      "expression": "ManningCoeff.s",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "length": {
      "type": "expression",
      "description": "Connector length",
      "expression": "length.s",
      "includeinoutput": "true",
      "ask_user": "false"
    },
    "sediment_exchange": {
      "type": "expression",
      "expression": "0",
      "description": "Settling and resuspension of suspended sediment across this link (1 = yes, 0 = no)",
      "ask_user": "false",
      "includeinoutput": "false"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "86400*((head.s-head.e)/length)/(_abs(((head.s-head.e)/length))+0.00000001)^0.5/ManningCoeff*area*hydraulic_radious^0.666667",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    }
  },
  "Suspended_sediment": {
    "type": "constituent",
    "typecategory": "Constituents",
    "description": "Suspended sediment",
    "icon": {
      "filename": "suspended_sediment.png"
    },
    "helptext": "Suspended sediment carried by the river: it settles at its settling velocity and is resuspended from the bed when the velocity exceeds v0, at the rate e = alpha (v - v0)^beta.",
    "concentration": {
      "description": "Concentration",
      "type": "expression",
      "expression": "mass/Storage",
      "ask_user": "true",
      "role": "copytoblocks",
      "includeinoutput": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "g/m~^3"
    },
    "settling_velocity": {
      "description": "Settling velocity",
      "type": "value",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m/s;m/day;ft/s;ft/day"
    },
    "alpha": {
      "description": "Alpha coefficient in resuspension rate",
      "helptext": "The resuspension flux from bed sediments (g/m2/day) is calculated as:\n e = alpha*max(|v|-v0, 0)^beta,\nwith v the velocity of the river segment. It applies only across River-to-bed-sediment links.",
      "type": "value",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true"
    },
    "beta": {
      "description": "Beta exponent in resuspension rate",
      "helptext": "The resuspension flux from bed sediments (g/m2/day) is calculated as:\n e = alpha*max(|v|-v0, 0)^beta,\nwith v the velocity of the river segment. It applies only across River-to-bed-sediment links.",
      "type": "value",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true"
    },
    "velocity_0": {
      "description": "v0, velocity treshold for resuspension",
      "helptext": "The resuspension flux from bed sediments (g/m2/day) is calculated as:\n e = alpha*max(|v|-v0, 0)^beta,\nwith v the velocity of the river segment. It applies only across River-to-bed-sediment links.",
      "type": "value",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m/s;m/day;ft/s;ft/day"
    },
    "stoichiometric_constant": {
      "description": "Stoichiometric Constant",
      "type": "expression",
      "ask_user": "true",
      "role": "copytoreactions",
      "includeinoutput": "false",
      "delegate": "expressionEditor"
    },
    "mass": {
      "description": "Mass",
      "type": "balance",
      "massbalance": "true",
      "flow": "masstransfer",
      "inflow": "external_mass_flow_timeseries,external_source",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytoblocks",
      "initial_value_expression": "concentration*Storage"
    },
    "slope": {
      "type": "expression",
      "expression": "(bottom_elevation.s-bottom_elevation.e)/length",
      "includeinoutput": "false",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "settling_transfer": {
      "description": "Mass transfer rate through depsition (g/day)",
      "type": "expression",
      "expression": "sediment_exchange*settling_velocity*area*(_pos(_sgn(slope))*concentration.s-_pos(-_sgn(slope))*concentration.e)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "advective_transfer": {
      "description": "Advective mass transfer (g/day)",
      "type": "expression",
      "expression": "_ups(flow;concentration)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "masstransfer": {
      "description": "Mass transfer rate",
      "type": "expression",
      "expression": "advective_transfer+settling_transfer-resuspension_rate",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "resuspension_rate": {
      "description": "Resuspension rate",
      "type": "expression",
      "expression": "sediment_exchange*alpha*_pos(_abs(velocity.s)-velocity_0)^beta*concentration.e/(concentration.e+0.0001)*area.e",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "external_mass_flow_timeseries": {
      "type": "timeseries",
      "includeinoutput": "true",
      "description": "External mass flow time-series",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "Browser"
    },
    "external_source": {
      "type": "source",
      "includeinoutput": "true",
      "description": "External source",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "ComboBox;Sources"
    }
  },
  "River_to_bed_sediment": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "River segment to bed sediment (Darcy exchange)",
    "icon": {
      "filename": "river_bed_exchange.png"
    },
    "helptext": "Vertical exchange between a river segment (or pond) and the bed sediment under it by Darcy's law: Q = K A (h_river - h_bed) / L, with A the plan area of the bed layer and L half its thickness. Positive flow is downward (infiltration into the bed).",
    "length": {
      "type": "expression",
      "expression": "depth.e/2",
      "description": "Length",
      "includeinoutput": "false"
    },
    "area": {
      "type": "expression",
      "expression": "length.e*width.e",
      "description": "Length",
      "includeinoutput": "false"
    },
    "sediment_exchange": {
      "type": "expression",
      "expression": "1",
