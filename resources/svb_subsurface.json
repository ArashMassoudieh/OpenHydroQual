{
  "Aggregate_storage_layer_confined": {
    "type": "block",
    "typecategory": "Blocks",
    "description": "Aggregate zone with a finite thickness: unconfined (porosity) storage up to the top of the layer, small confined storativity above it",
    "icon": {
      "filename": "aggregates.png"
    },
    "Storage": {
      "type": "balance",
      "massbalance": "true",
      "flow": "flow",
      "inflow": "inflow",
      "includeinoutput": "true",
      "description": "Initial Storage;Storage",
      "initial_value_expression": "area*depth*porosity",
      "ask_user": "false",
      "default": "0",
      "unit": "m~^3;ft~^3",
      "estimate": "true"
    },
    "inflow": {
      "type": "timeseries",
      "includeinoutput": "true",
      "applylimit": "true",
      "description": "Inflow time series",
      "ask_user": "true",
      "delegate": "Browser",
      "unit": "m^3/day;ft^3/s"
    },
    "K_sat": {
      "type": "value",
      "description": "Saturated Hydraulc Conductivity",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m/day;ft/day;m/s;ft/s",
      "includeinoutput": "true",
      "estimate": "true",
      "default": "1",
      "criteria": "K_sat>0",
      "warningmessage": "Saturated Hydraulic Conductivity must be greater than zero"
    },
    "area": {
      "type": "value",
      "description": "Base Area",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m~^2;ft~^2",
      "estimate": "true",
      "criteria": "area>0",
      "warningmessage": "Base area must be positive"
    },
    "bottom_elevation": {
      "type": "value",
      "description": "Bottom Elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "porosity": {
      "type": "value",
      "description": "Porosity",
      "ask_user": "true",
      "default": "0.4",
      "delegate": "ValueBox",
      "estimate": "true"
    },
    "depth": {
      "type": "expression",
      "expression": "_min(Storage/(area*porosity);thickness)+_pos(Storage-area*porosity*thickness)/(area*confined_storativity)",
      "description": "Initial Water Depth; Water Depth",
      "ask_user": "true",
      "helptext": "Initial depth must not exceed the thickness. Above the top of the layer the head rises with confined_storativity instead of porosity.",
      "delegate": "UnitBox",
      "unit": "m;ft;cm",
      "includeinoutput": "true"
    },
    "head": {
      "type": "expression",
      "expression": "depth+bottom_elevation",
      "description": "Hydraulic Head",
      "ask_user": "false",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "thickness": {
      "type": "value",
      "description": "Thickness of the aggregate layer",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "default": "1000",
      "criteria": "thickness>0",
      "warningmessage": "Thickness must be positive",
      "estimate": "true"
    },
    "confined_storativity": {
      "type": "value",
      "description": "Storage per unit area per unit head rise once the layer is full (dimensionless)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "default": "0.05",
      "criteria": "confined_storativity>0",
      "warningmessage": "Confined storativity must be positive",
      "estimate": "true"
    },
    "saturated_thickness": {
      "type": "expression",
      "expression": "_min(depth;thickness)",
      "description": "Saturated thickness",
      "includeinoutput": "true",
      "unit": "m;ft"
    },
    "helptext": "Aggregate (gravel) layer of finite thickness. Head = bottom_elevation + depth; transmissive thickness = min(depth, thickness)."
  },
  "channel_to_aggregate_link_Kv": {
    "type": "link",
    "typecategory": "Connectors",
    "icon": {
      "filename": "channel2aggregate.png"
    },
    "description": "Channel to aggregate layer with an interface conductivity K_v",
    "area": {
      "type": "expression",
      "description": "Interface area",
      "expression": "_min(length.s*(base_width.s+2*side_slope.s*_pos(depth.s));area.e)",
      "includeinoutput": "true",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Plan (water-surface) area of the channel segment: segment length x top width (base_width + 2 x side_slope x depth), capped at the aggregate layer's base area."
    },
    "length": {
      "type": "value",
      "description": "Length",
      "ask_user": "true",
      "unit": "m;ft",
      "delegate": "UnitBox",
      "criteria": "length>0",
      "warningmessage": "Length must be positive",
      "helptext": "This is the length from the center of the channel water body to the centroid of the aggregate layer"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "(head.s-head.e)*K_v/length*area",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    },
    "color": {
      "type": "string",
      "default": "0,0,180"
    },
    "helptext": "Exchange between a channel segment and the aggregate beneath it; conductance K_v*area/length, independent of the aggregate's horizontal K_sat",
    "K_v": {
      "type": "value",
      "description": "Interface (vertical) hydraulic conductivity",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m/day;m/s;ft/s",
      "default": "1",
      "criteria": "K_v>0",
      "warningmessage": "K_v must be positive",
      "estimate": "true",
      "includeinoutput": "false"
    }
  },
  "aggregate2aggregate_H_Link_b": {
    "type": "link",
    "typecategory": "Connectors",
    "icon": {
      "filename": "aggregate2aggregate_H.png"
    },
    "description": "Horizontal Darcy flow between two confined-thickness aggregate layers",
    "width": {
      "type": "value",
      "description": "Interface Width",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "includeinoutput": "false",
      "ask_user": "true"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "includeinoutput": "false",
      "ask_user": "true"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "(head.s-head.e)*(K_sat.s+K_sat.e)/(4*length)*(saturated_thickness.s+saturated_thickness.e)*width",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    },
    "color": {
      "type": "string",
      "default": "130,20,220"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    }
  },
  "aggregate_to_collector_link": {
    "type": "link",
    "typecategory": "Connectors",
    "icon": {
      "filename": "aggregate2aggregate_H.png"
    },
    "description": "Darcy flow from an aggregate layer to an outlet collector/box",
    "width": {
      "type": "value",
      "description": "Interface Width",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "includeinoutput": "false",
      "ask_user": "true"
    },
    "length": {
      "type": "value",
      "description": "Length",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "includeinoutput": "false",
      "ask_user": "true"
    },
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "(head.s-head.e)*K_sat.s/length*saturated_thickness.s*width",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    },
    "color": {
      "type": "string",
      "default": "130,20,220"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    },
    "helptext": "Flow from the aggregate toward a collector; length = distance from the cell centroid to the collector, width = width of the collector face"
  },
  "weir_two_sided": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Power-law weir that accounts for the downstream water level: Q = alpha*((h_s-z)+^beta - (h_e-z)+^beta)",
    "icon": {
      "filename": "vnotchweir.png"
    },
    "color": {
      "type": "string",
      "default": "0,200,200"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Crest Elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "alpha": {
      "type": "value",
      "description": "Coefficient alpha in Q=alpha*(h-z_0)^beta (SI-day units)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1",
      "criteria": "alpha>0",
      "warningmessage": "alpha must be positive"
    },
    "beta": {
      "type": "value",
      "description": "Exponent beta in Q=alpha*(h-z_0)^beta",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "2.5",
      "criteria": "beta>0",
      "warningmessage": "beta must be positive"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "alpha*(_pos(head.s-crest_elevation)^beta-_pos(head.e-crest_elevation)^beta)",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/day"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "expression": "alpha*(_pos(head.s-crest_elevation)^beta-_pos(head.e-crest_elevation)^beta)",
      "includeinoutput": "false",
      "applylimit": "false",
      "unit": "m^2;ft^2"
    },
    "length": {
      "type": "value",
      "description": "length",
      "default": "1",
      "includeinoutput": "false"
    }
  },
  "wier_time_variable_crest": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Power-law weir whose crest elevation is a time series (e.g., an eroding and repaired check dam)",
    "icon": {
      "filename": "vnotchweir.png"
    },
    "color": {
      "type": "string",
      "default": "0,200,200"
    },
    "crest_elevation": {
      "type": "timeseries",
      "description": "Crest elevation time series",
      "ask_user": "true",
      "delegate": "Browser",
      "unit": "m;ft",
      "includeinoutput": "true",
      "estimate": "true"
    },
    "alpha": {
      "type": "value",
      "description": "Coefficient alpha in Q=alpha*(h-z_0)^beta (SI-day units)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1",
      "criteria": "alpha>0",
      "warningmessage": "alpha must be positive"
    },
    "beta": {
      "type": "value",
      "description": "Exponent beta in Q=alpha*(h-z_0)^beta",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "2.5",
      "criteria": "beta>0",
      "warningmessage": "beta must be positive"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "alpha*_pos(head.s-crest_elevation)^beta",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/day"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "expression": "alpha*_pos(head.s-crest_elevation)^beta",
      "includeinoutput": "false",
      "applylimit": "false",
      "unit": "m^2;ft^2"
    },
    "length": {
      "type": "value",
      "description": "length",
      "default": "1",
      "includeinoutput": "false"
    }
  },
  "weir_capped": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Power-law weir whose discharge is smoothly capped by a maximum (e.g., the capacity of the pipe it feeds): Q = Qw*Q_max/(Qw^n+Q_max^n)^(1/n), Qw = alpha*(h_s-z)+^beta",
    "icon": {
      "filename": "vnotchweir.png"
    },
    "color": {
      "type": "string",
      "default": "0,200,200"
    },
    "crest_elevation": {
      "type": "value",
      "description": "Crest Elevation",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "alpha": {
      "type": "value",
      "description": "Coefficient alpha in Q=alpha*(h-z_0)^beta (SI-day units)",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "1",
      "criteria": "alpha>0",
      "warningmessage": "alpha must be positive"
    },
    "beta": {
      "type": "value",
      "description": "Exponent beta in Q=alpha*(h-z_0)^beta",
      "ask_user": "true",
      "delegate": "ValueBox",
      "estimate": "true",
      "default": "2.5",
      "criteria": "beta>0",
      "warningmessage": "beta must be positive"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "expression": "free_flow*Q_max/(free_flow^n+Q_max^n)^(1/n)",
      "includeinoutput": "true",
      "applylimit": "true",
      "unit": "m^3/day;ft^3/day"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "expression": "free_flow*Q_max/(free_flow^n+Q_max^n)^(1/n)",
      "includeinoutput": "false",
      "applylimit": "false",
      "unit": "m^2;ft^2"
    },
    "length": {
      "type": "value",
      "description": "length",
      "default": "1",
      "includeinoutput": "false"
    },
    "Q_max": {
      "type": "value",
      "description": "Maximum discharge (capacity of the downstream pipe)",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m^3/day;m^3/s;ft^3/s",
      "default": "1000",
      "criteria": "Q_max>0",
      "warningmessage": "Q_max must be positive",
      "estimate": "true"
    },
    "n": {
      "type": "value",
      "description": "Sharpness of the cap (large n approaches min(Qw, Q_max))",
      "ask_user": "true",
      "delegate": "ValueBox",
      "default": "4",
      "criteria": "n>0",
      "warningmessage": "n must be positive",
      "estimate": "true"
    },
    "free_flow": {
      "type": "expression",
      "description": "Uncapped weir discharge",
      "expression": "alpha*_pos(head.s-crest_elevation)^beta",
      "includeinoutput": "true",
      "unit": "m^3/day;ft^3/day"
    },
    "helptext": "Weir (or riser) feeding a pipe of limited capacity. Below the cap it behaves as the power-law weir; above it the discharge approaches Q_max smoothly (continuous derivative)."
  },
  "surface_to_collector_link": {
    "type": "link",
    "typecategory": "Connectors",
    "icon": {
      "filename": "aggregate2aggregate_H.png"
    },
    "description": "Ponded surface water draining vertically through a gravel layer into a collector (end-wall strip)",
    "flow": {
      "type": "expression",
      "description": "Flow",
      "expression": "(head.s-head.e)*K*width*strip_length/thickness*_pos(depth.s)/(_pos(depth.s)+0.01)",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "unit": "m^3/day;m^3/s;ft^3/s"
    },
    "color": {
      "type": "string",
      "default": "130,20,220"
    },
    "area": {
      "type": "value",
      "description": "Area",
      "default": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "unit": "m^2;ft^2",
      "helptext": "Cross-sectional area used only for diffusive constituent transport across this link; does not affect flow."
    },
    "K": {
      "type": "value",
      "description": "Hydraulic conductivity of the gravel",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m/day;m/s;ft/s",
      "default": "1000",
      "criteria": "K>0",
      "warningmessage": "K must be positive",
      "estimate": "true"
    },
    "width": {
      "type": "value",
      "description": "Width of the strip (collector length)",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "strip_length": {
      "type": "value",
      "description": "Length of the strip above/next to the collector that drains vertically",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "thickness": {
      "type": "value",
      "description": "Vertical path length through the gravel (layer thickness)",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m;ft",
      "estimate": "true"
    },
    "helptext": "From a channel/ponded block to a collector box: Darcy flow through the gravel thickness over a strip of plan area width*strip_length; active only while the source holds ponded water."
  }
}