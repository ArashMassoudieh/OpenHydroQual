  "Flex_flow": {
    "type": "link",
    "typecategory": "Connectors",
    "description": "Storage-based flow",
    "icon": {
      "filename": "flex-flow.png"
    },
    "flow": {
      "type": "expression",
      "description": "Flow rate",
      "includeinoutput": "true",
      "applylimit": "true",
      "ask_user": "false",
      "expression": "(Storage.s/Volume.s-1)*flow_factor",
      "unit": "m^3/day;ft~^3/day;m^3/s;ft^~3/s"
    },
    "flow_factor": {
      "type": "value",
      "description": "Flow factor",
      "includeinoutput": "false",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "m^3/day;ft~^3/day;m^3/s;ft^~3/s",
      "default": "1000000"
    },
    "length": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "1",
      "ask_user": "false"
    },
    "area": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "Area",
      "ask_user": "false"
    },
    "color": {
      "type": "string",
      "default": "0,0,200"
    }
  },
