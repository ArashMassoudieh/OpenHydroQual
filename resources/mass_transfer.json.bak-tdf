  "Sorbed_Constituent": {
    "type": "constituent",
    "typecategory": "Constituents",
    "description": "sorbed chemical constituent",
    "icon": {
      "filename": "sorbed_constituent.png"
    },
    "concentration": {
      "description": "Concentration per total volume",
      "type": "expression",
      "expression": "mass/volume",
      "ask_user": "true",
      "role": "copytoblocks",
      "includeinoutput": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "g/m^3"
    },
    "stoichiometric_constant": {
      "description": "Stoichiometric Constant",
      "type": "expression",
      "ask_user": "true",
      "role": "copytoreactions",
      "includeinoutput": "false",
      "delegate": "expressionEditor"
    },
    "mass": {
      "description": "Mass",
      "type": "balance",
      "massbalance": "true",
      "flow": "masstransfer",
      "inflow": "external_mass_flow_timeseries,external_source",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytoblocks",
      "initial_value_expression": "concentration*depth*area",
      "unit": "g;kg"
    },
    "masstransfer": {
      "description": "Mass transfer rate",
      "type": "expression",
      "expression": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "external_mass_flow_timeseries": {
      "type": "timeseries",
      "includeinoutput": "true",
      "description": "External mass flow time-series",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "Browser",
      "unit": "g/day"
    },
    "external_source": {
      "type": "source",
      "includeinoutput": "true",
      "description": "External source",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "ComboBox;Sources"
    }
  },
  "Immobile_Constituent": {
    "type": "constituent",
    "typecategory": "Constituents",
    "description": "Immobile constituent",
    "icon": {
      "filename": "immobile_constituent_reactor.png"
    },
    "concentration": {
      "description": "Concentration per total volume",
      "type": "expression",
      "expression": "mass/(Storage+0.00001)",
      "ask_user": "true",
      "role": "copytoblocks",
      "includeinoutput": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "g/m^3"
    },
    "stoichiometric_constant": {
      "description": "Stoichiometric Constant",
      "type": "expression",
      "ask_user": "true",
      "role": "copytoreactions",
      "includeinoutput": "false",
      "delegate": "expressionEditor"
    },
    "mass": {
      "description": "Mass",
      "type": "balance",
      "massbalance": "true",
      "flow": "masstransfer",
      "inflow": "external_mass_flow_timeseries,external_source",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytoblocks",
      "initial_value_expression": "concentration*Storage"
    },
    "masstransfer": {
      "description": "Mass transfer rate",
      "type": "expression",
      "expression": "0",
      "includeinoutput": "false",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "external_mass_flow_timeseries": {
      "type": "timeseries",
      "includeinoutput": "true",
      "description": "External mass flow time-series",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "Browser",
      "unit": "g/day"
    },
    "external_source": {
      "type": "source",
      "includeinoutput": "true",
      "description": "External source",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "ComboBox;Sources",
      "unit": "g/day"
    }
  },
  "Desorption": {
    "type": "Reaction",
    "description": "Desorption",
    "typecategory": "Reactions",
    "normalizing_quantity": "volume",
    "icon": {
      "filename": "desorption.png"
    },
    "rate_expression": {
      "description": "Rate Expression",
      "type": "expression",
      "ask_user": "true",
      "delegate": "expressionEditor"
    }
  },
  "AgeTracker": {
    "type": "constituent",
    "typecategory": "Constituents",
    "description": "Mean Age Tracker",
    "icon": {
      "filename": "Age_tracer.png"
    },
    "concentration": {
      "description": "Concentration",
      "type": "expression",
      "expression": "mass/(Storage+0.0001)",
      "ask_user": "true",
      "role": "copytoblocks",
      "includeinoutput": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "g/m^3"
    },
    "stoichiometric_constant": {
      "description": "Stoichiometric Constant",
      "type": "expression",
      "ask_user": "true",
      "role": "copytoreactions",
      "includeinoutput": "false",
      "delegate": "expressionEditor"
    },
    "mass": {
      "description": "Mass",
      "type": "balance",
      "massbalance": "true",
      "flow": "masstransfer",
      "inflow": "external_mass_flow_timeseries,external_source,inflow_loading",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytoblocks",
      "initial_value_expression": "concentration*Storage"
    },
    "diffusion_coefficient": {
      "description": "Diffusion Coefficient",
      "type": "value",
      "ask_user": "true",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "m^2/s;m^2/day;ft~^2/s;ft~^2/day"
    },
    "advective_masstransfer": {
      "description": "Advective mass transfer rate",
      "type": "expression",
      "expression": "_ups(flow;concentration)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "upstrm_concentration": {
      "description": "Upstream Concentration",
      "type": "expression",
      "expression": "_ups(flow;concentration)/_abs(flow)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks",
      "unit": "g/m^3"
    },
    "Load": {
      "description": "Decayed Load",
      "type": "expression",
      "expression": "flow*_exp(-decay_parameter*upstrm_concentration)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks"
    },
    "decay_parameter": {
      "description": "Decay parameter",
      "type": "value",
      "includeinoutput": "false",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "1/day",
      "default": "0",
      "ask_user": "true",
      "role": "copytolinks"
    },
    "diffusive_masstransfer": {
      "description": "Diffusive mass transfer rate",
      "type": "expression",
      "expression": "diffusion_coefficient*area/length*(concentration.s-concentration.e)",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks",
      "unit": "g/m^3/day"
    },
    "masstransfer": {
      "description": "Total mass transfer rate",
      "type": "expression",
      "expression": "advective_masstransfer+diffusive_masstransfer",
      "includeinoutput": "true",
      "ask_user": "false",
      "role": "copytolinks",
      "unit": "g/m^3/day"
    },
    "external_mass_flow_timeseries": {
      "type": "timeseries",
      "includeinoutput": "true",
      "description": "External mass flow time-series",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "Browser",
      "unit": "g/m^3"
    },
    "inflow_concentration": {
      "type": "value",
      "includeinoutput": "false",
      "description": "Inflow concentration",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "ValueBox",
      "default": "0",
      "unit": "g/m^3"
    },
    "inflow_loading": {
      "type": "expression",
      "expression": "inflow_concentration*(inflow+Precipitation)+Evapotranspiration*concentration",
      "includeinoutput": "true",
      "description": "Inflow loading",
      "role": "copytoblocks",
      "unit": "g/m^3/day"
    },
    "external_source": {
      "type": "source",
      "includeinoutput": "true",
      "description": "External source",
      "ask_user": "true",
      "role": "copytoblocks",
      "delegate": "ComboBox;Sources",
      "unit": "g/m^3/day"
    }
  },
