{
  "chemical_source_timeseries": {
    "type": "source",
    "typecategory": "Sources",
    "description": "Chemical source time series",
    "icon": {
      "filename": "Chemical_Source_timeseries.png"
    },
    "timeseries": {
      "type": "timeseries",
      "includeinoutput": "true",
      "description": "Loading rate (mass/time)",
      "ask_user": "true",
      "delegate": "Browser;time series",
      "helptext": "Time series representing the chemical mass loading rate into the system (e.g., from external sources or emissions).",
      "unit": "g/day/m^3"
    }
  },
  "constant_source": {
    "type": "source",
    "typecategory": "Sources",
    "description": "Chemical source - constant",
    "icon": {
      "filename": "Chemical_source_constant.png"
    },
    "rate_per_volume": {
      "type": "value",
      "includeinoutput": "false",
      "description": "Loading rate (mass/time/volume of water)",
      "ask_user": "true",
      "delegate": "UnitBox",
      "unit": "g/day/m^3",
      "helptext": "Constant chemical loading rate per unit volume of water. Used for modeling uniformly distributed internal sources."
    },
    "coefficient": {
      "type": "expression",
      "expression": "Storage*rate_per_volume",
      "includeinoutput": "false",
      "description": "Production rate",
      "ask_user": "false"
    },
    "timeseries": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "1",
      "ask_user": "false"
    }
  },
  "atmospheric exchange": {
    "type": "source",
    "typecategory": "Sources",
    "description": "Atmospheric Exchange",
    "icon": {
      "filename": "Chemical_Source_exchange.png"
    },
    "rate_coefficient": {
      "type": "value",
      "ask_user": "true",
      "description": "Rate coefficient",
      "delegate": "UnitBox",
      "estimate": "true",
      "unit": "1/day;1/s;1/hr",
      "helptext": "Rate coefficient representing the speed of mass exchange between water and atmosphere (e.g., volatilization or gas transfer)."
    },
    "saturation": {
      "type": "value",
      "ask_user": "true",
      "description": "Saturation Concentration Level",
      "delegate": "UnitBox",
      "unit": "g/m^3",
      "helptext": "Saturation concentration in water under equilibrium with the atmosphere. Determines direction and magnitude of flux."
    },
    "coefficient": {
      "type": "expression",
      "expression": "Storage*rate_coefficient*(saturation-concentration)",
      "includeinoutput": "false",
      "description": "Transfer rate",
      "ask_user": "false"
    },
    "timeseries": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "1",
      "ask_user": "false"
    }
  },
  "surface_atmospheric exchange": {
    "type": "source",
    "typecategory": "Sources",
    "description": "Surface Atmospheric Exchange",
    "icon": {
      "filename": "Surface_Chemical_Source_exchange.png"
    },
    "rate_coefficient": {
      "type": "value",
      "ask_user": "true",
      "description": "Rate coefficient",
      "delegate": "UnitBox",
      "unit": "m/day;m/s;m/hr",
      "helptext": "Surface-based mass transfer coefficient, representing rate of chemical exchange per unit surface area."
    },
    "saturation": {
      "type": "value",
      "ask_user": "true",
      "description": "Saturation Concentration Level",
      "delegate": "UnitBox",
      "unit": "g/m^3"
    },
    "coefficient": {
      "type": "expression",
      "expression": "area*rate_coefficient*(saturation-concentration)",
      "includeinoutput": "false",
      "description": "Transfer rate",
      "ask_user": "false"
    },
    "timeseries": {
      "type": "expression",
      "expression": "1",
      "includeinoutput": "false",
      "description": "1",
      "ask_user": "false"
    }
  },
  "Reactor": {
