\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The property panel of the \texttt  {\small  Clarifier (4 layers)} composite. Every value of Table~\ref {tab:basin} is visible at once --- note \textsf  {Depth of the clarifier} and \textsf  {Elevation of the clarifier floor} in place of four separate layer elevations, \textsf  {Initial volume of water in the clarifier} in place of four layer volumes, and \textsf  {Flow drawn downward through the layers} $=0$. There is no per-layer entry anywhere in the panel: that geometry is derived. The \texttt  {\small  P4:\ldots  } rows at the top are the per-constituent properties, which stay at zero --- the basin starts clean.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:03-basin-properties}{{3}{7}{The property panel of the \code {Clarifier (4 layers)} composite. Every value of Table~\ref {tab:basin} is visible at once --- note \menu {Depth of the clarifier} and \menu {Elevation of the clarifier floor} in place of four separate layer elevations, \menu {Initial volume of water in the clarifier} in place of four layer volumes, and \menu {Flow drawn downward through the layers} $=0$. There is no per-layer entry anywhere in the panel: that geometry is derived. The \code {P4:\ldots } rows at the top are the per-constituent properties, which stay at zero --- the basin starts clean}{figure.3}{}}
